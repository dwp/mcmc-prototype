{% extends "layouts/layout.njk" %}

{% block content %}
{{ govukBackLink({
      "text": "Back",
      "href": "javascript: window.history.go(-1)"
    }) 
}}

	<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

<div class="govuk-form-group">
  <fieldset class="govuk-fieldset">
    <legend class="govuk-fieldset__legend govuk-fieldset__legend--xl">
      <h1 class="govuk-fieldset__heading">
        Which child do you need to tell us about?
      </h1>
    </legend>
    <div id="change-hint" class="govuk-hint">
      Report changes to each child separately
    </div>
    <div>
    <h2 class="govuk-heading-l">Children you pay Child Maintenance for</h2>
    </div>
    <div class="govuk-radios" data-module="govuk-radios">
      <div class="govuk-radios__item">
        <input class="govuk-radios__input" id="cmsChild" name="cmsChild" type="radio" value="George">
        <label class="govuk-label govuk-radios__label" for="cmsChild">
          George
        </label>
      </div>
      <div class="govuk-radios__item">
        <input class="govuk-radios__input" id="cmsChild-1" name="cmsChild" type="radio" value="Olivia">
        <label class="govuk-label govuk-radios__label" for="cmsChild-1">
          Olivia
        </label>
      </div>
      <div class="govuk-radios__item">
        <input class="govuk-radios__input" id="cmsChild-2" name="cmsChild" type="radio" value="Alex">
        <label class="govuk-label govuk-radios__label" for="cmsChild-2">
          Alex
        </label>
      </div>
       <div class="govuk-radios__divider">or</div>
      <div class="govuk-radios__item">
        <input class="govuk-radios__input" id="cmsChild-3" name="cmsChild" type="radio" value="abroad">
        <label class="govuk-label govuk-radios__label" for="cmsChild-3">
          A child you need to add to Child Maintenance
        </label>
      </div>
    </div>
  </fieldset>
</div>

    <div>
    <h2 class="govuk-heading-l">Other children you financially support</h2>
    </div>
    <div class="govuk-radios" data-module="govuk-radios">
      <div class="govuk-radios__item">
        <input class="govuk-radios__input" id="cmsChild-4" name="cmsChild" type="radio" value="Jade">
        <label class="govuk-label govuk-radios__label" for="cmsChild-4">
          Jade
        </label>
      </div>
      <div class="govuk-radios__item">
        <input class="govuk-radios__input" id="cmsChild-5" name="cmsChild" type="radio" value="Joe">
        <label class="govuk-label govuk-radios__label" for="cmsChild-5">
          Joe
        </label>
      </div>
      <div class="govuk-radios__item">
        <input class="govuk-radios__input" id="cmsChild-6" name="cmsChild" type="radio" value="Jasmine">
        <label class="govuk-label govuk-radios__label" for="cmsChild-6">
          Jasmine
        </label>
      </div>
       <div class="govuk-radios__divider">or</div>
      <div class="govuk-radios__item">
        <input class="govuk-radios__input" id="cmsChild-7" name="cmsChild" type="radio" value="a new child you financially support">
        <label class="govuk-label govuk-radios__label" for="cmsChild-7">
          A new child you financially support
        </label>
      </div>
  </fieldset>
  <br>
<div>
      <button type="submit" class="govuk-button">
        Continue
      </button>
</div>
	 </form>

	  </div>
	  </div>

{% endblock %}