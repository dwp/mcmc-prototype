{% extends "layouts/layout.njk" %}

{% block content %}
{{ govukBackLink({
      "text": "Back",
      "href": "javascript: window.history.go(-1)"
    }) 
}}

	<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

<div class="govuk-form-group">
  <fieldset class="govuk-fieldset">
    <legend class="govuk-fieldset__legend govuk-fieldset__legend--xl">
      <h1 class="govuk-fieldset__heading">
        Which child do you need to tell us about?
      </h1>
    </legend>
    <div id="change-hint" class="govuk-hint">
      Report changes to each child separately
    </div>
    <div>
    <h2 class="govuk-heading-l">Children you pay Child Maintenance for</h2>
    </div>
    <div class="govuk-radios" data-module="govuk-radios">
      <div class="govuk-radios__item">
        <input class="govuk-radios__input" id="whichChild" name="whichChild" type="radio" value="Geroge">
        <label class="govuk-label govuk-radios__label" for="whichChild">
          George - born 5 April 2010
        </label>
      </div>
      <div class="govuk-radios__item">
        <input class="govuk-radios__input" id="whichChild-2" name="whichChild" type="radio" value="George">
        <label class="govuk-label govuk-radios__label" for="whichChild-2">
          George - born 6 Sep 2017
        </label>
      </div>
      <div class="govuk-radios__item">
        <input class="govuk-radios__input" id="whereDoYouLive-3" name="whereDoYouLive" type="radio" value="Olivia">
        <label class="govuk-label govuk-radios__label" for="whereDoYouLive-3">
          Olivia
        </label>
      </div>
      <div class="govuk-radios__item">
        <input class="govuk-radios__input" id="whereDoYouLive-4" name="whereDoYouLive" type="radio" value="Alex">
        <label class="govuk-label govuk-radios__label" for="whereDoYouLive-4">
          Alex
        </label>
      </div>
       <div class="govuk-radios__divider">or</div>
      <div class="govuk-radios__item">
        <input class="govuk-radios__input" id="whereDoYouLive-6" name="whereDoYouLive" type="radio" value="abroad">
        <label class="govuk-label govuk-radios__label" for="whereDoYouLive-6">
          A child you need to add to Child Maintenance
        </label>
      </div>
    </div>
  </fieldset>
</div>

    <div>
    <h2 class="govuk-heading-l">Other children you financially support</h2>
    </div>
    <div class="govuk-radios" data-module="govuk-radios">
      <div class="govuk-radios__item">
        <input class="govuk-radios__input" id="whereDoYouLive" name="whereDoYouLive" type="radio" value="england">
        <label class="govuk-label govuk-radios__label" for="whereDoYouLive">
          Jade - born 9 Apr 2019
        </label>
      </div>
      <div class="govuk-radios__item">
        <input class="govuk-radios__input" id="whereDoYouLive-2" name="whereDoYouLive" type="radio" value="scotland">
        <label class="govuk-label govuk-radios__label" for="whereDoYouLive-2">
          Jade - born 9 Sep 2020
        </label>
      </div>
      <div class="govuk-radios__item">
        <input class="govuk-radios__input" id="whereDoYouLive-3" name="whereDoYouLive" type="radio" value="wales">
        <label class="govuk-label govuk-radios__label" for="whereDoYouLive-3">
          Joe
        </label>
      </div>
      <div class="govuk-radios__item">
        <input class="govuk-radios__input" id="whereDoYouLive-4" name="whereDoYouLive" type="radio" value="northern-ireland">
        <label class="govuk-label govuk-radios__label" for="whereDoYouLive-4">
          Jasmine
        </label>
      </div>
       <div class="govuk-radios__divider">or</div>
      <div class="govuk-radios__item">
        <input class="govuk-radios__input" id="whereDoYouLive-6" name="whereDoYouLive" type="radio" value="abroad">
        <label class="govuk-label govuk-radios__label" for="whereDoYouLive-6">
          A new child you financially support
        </label>
      </div>
  </fieldset>
  <br>
<div>
      <button type="submit" class="govuk-button">
        Continue
      </button>
</div>
	 </form>

	  </div>
	  </div>

{% endblock %}